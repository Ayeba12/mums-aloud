# Copy to .env.local for local work. Set the same names in Vercel > Project > Settings > Environment Variables.
# Never commit real secrets. A blank value counts as unset.

# WordPress REST API (the headless CMS at cms.mumsaloud.com, since 28 Oct 2026; docs/cms-setup.md).
# The media host and the wp-admin and wp-content/uploads redirects follow this address.
# The site reads all content through WPGraphQL at this endpoint (defaults to <CMS origin>/graphql).
WORDPRESS_GRAPHQL_URL=https://cms.mumsaloud.com/graphql
# The same WordPress's REST base: it names the CMS for the media host and the wp-admin redirects; the importer and plugin use it.
WORDPRESS_API_URL=https://cms.mumsaloud.com/wp-json/wp/v2

# Public site URL, used for metadata and canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Join Mama's Escape destination: the new, open Google Form
NEXT_PUBLIC_JOIN_URL=

# Newsletter sign-up (the footer form and the newsletter dialog). Set ONE provider; the first
# configured wins. With none set the forms say sign-up is not open yet.
# MailerLite: an API token (MailerLite > Integrations > API) and, optionally, the group to add to.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
# Mailchimp: an API key (its "-us21"-style suffix names the data centre) and the audience ID.
# New subscribers are added as "pending", so Mailchimp sends its confirmation email.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Or any endpoint that accepts POST JSON {email, firstName, source, sentAt}.
NEWSLETTER_WEBHOOK_URL=

# Fallback for the forms when the sheet route above is not set (the route into info@mumsaloud.com): any endpoint that accepts a JSON POST
# ({name, email, organisation, phone, topic, message, source, sentAt}), e.g. a Formspree form, a Make/Zapier
# webhook or a Google Apps Script web app that emails the inbox. Leave empty until chosen;
# each form then offers a prefilled email to info@mumsaloud.com instead, so nothing is lost.
CONTACT_WEBHOOK_URL=

# The forms (Volunteer With Us, Contact, Partnership) deliver in two parts (docs/forms-sheet-setup.md).
# 1. The row: the Google Apps Script web app attached to the forms Google Sheet records each submission
#    on the form's tab. The secret must match the SECRET script property.
# Until a route is set, the forms fall back to CONTACT_WEBHOOK_URL, then to the prefilled email.
# The older names VOLUNTEER_WEBHOOK_URL / VOLUNTEER_WEBHOOK_SECRET / VOLUNTEER_NOTIFY_EMAIL still work.
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=
# Where the team's notifications go (defaults to info@mumsaloud.com).
FORMS_NOTIFY_EMAIL=
# 2. The emails: the sender's confirmation and the team's notification go out from the team mailbox
#    (info@mumsaloud.com on Titan Email) over SMTP. Host, port and user default to Titan and the site email;
#    sending is off until the mailbox password is set. Never commit it.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=info@mumsaloud.com
SMTP_PASSWORD=

# Shared secret for the WordPress publish webhook (POST /api/revalidate/)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Podcast episode feed (RSS). Defaults to the Mama's Escape show on Spotify for Creators.
# PODCAST_FEED_URL=https://anchor.fm/s/e0f9c9c4/podcast/rss
